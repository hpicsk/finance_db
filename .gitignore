# =============================================================================
# Credentials — NEVER commit
# =============================================================================
.token
*.token
krx_id
.env
*.key
*credentials*
dart_api
.dart_key

# OpenDartReader local cache (corp_code pickle, regenerable)
docs_cache/

# =============================================================================
# Large raw data — kept locally, not pushed
# =============================================================================

# FnGuide DataGuide xlsx exports (200 MB – 1.4 GB each, > GitHub 100 MB limit)
fnguide_data/*.xlsx
fnguide_data/currently_listed/*.xlsx
fnguide_data/raw/*.xlsx

# FnGuide adjusted-price panel (수정주가 + 수정주가(현금배당포함)), regenerable from
# raw/fnguide_price_adjclose_20260813.xlsx via fnguide_data/price_loader.py
fnguide_data/cache/

# The repo root is a container: no data files belong at this level. Backstop in
# case an export lands here instead of in fnguide_data/raw/.
/*.xlsx

# Backup zips
fnguide_data/*.zip
/*.zip

# marcap is an external clone of github.com/FinanceData/marcap (kept locally,
# not redistributed via this repo). The user-authored coverage note that
# was originally in marcap/ now lives in kr_delisted/README.md under
# "marcap coverage verification".
marcap/

# FinMind per-stock parquets (~1.6 GB total)
finmind_data/ohlcv/
finmind_data/price_adj/
finmind_data/instflow/
finmind_data/shares/
finmind_data/per_pbr/
finmind_data/margin_short/
finmind_data/month_rev/
finmind_data/fin_is/
finmind_data/fin_bs/
finmind_data/fin_cf/
finmind_data/dividend/
finmind_data/div_result/
finmind_data/sec_lending/
finmind_data/cap_red/

# Date-keyed full-market tape (~78 MB), regenerable from the endpoint via
# tape_universe.py. The per-code summary it rolls up to,
# tape_universe.parquet, is small and is tracked — that is the file the
# assertions read.
finmind_data/tape/

# Capital-reduction consolidated output is regenerable from cap_red/ via
# consolidate_capred.py
finmind_data/capital_reduction.parquet

# Per-company 財務報告書 filing indexes from TWSE's document server (~23 MB,
# 2,230 files), regenerable via filing_dates.py — budget a day, the server
# allows a burst of ~14 requests then a cooldown. The company-quarter panel it
# rolls up to, filing_dates.parquet, is small and is tracked — that is the file
# the assertions read.
finmind_data/filing_dates/

# Unpriced share cancellations, regenerable from shares/ via
# detect_unpriced_actions.py
finmind_data/unpriced_actions.parquet

# TWSE 除權除息計算結果表, regenerable from twse.com.tw via download_exright.py
finmind_data/exright_reference.parquet

# NOT ignored, deliberately: finmind_data/vendor_event_audit.parquet. It grades
# the vendor's adjusted series against the exchange event by event, so it is a
# snapshot of something that can change under a re-download rather than a
# derivation of something stable — the same reason krx_adj_oracle.parquet is
# kept below. adjusted_loader patches seven events off it, and
# test_assertions.py regenerates it and fails if the committed copy has drifted.

# Investor-aggregate generated CSV (regenerable via transform_investor_data.py)
fnguide_data/investor_aggregate/investor_trading_data.csv

# kr_delisted archived raw downloads (302 MB)
kr_delisted/.archived_*/

# kr_marcap built caches (regenerable from marcap/ via build_universe_panel()
# and build_adjustment_factors()). Exception: krx_adj_oracle.parquet is a pykrx
# snapshot (live KRX, hours to recollect, NOT regenerable from marcap) — archived
# so the price adjustment is reproducible without re-fetching the oracle.
kr_marcap/cache/*
!kr_marcap/cache/krx_adj_oracle.parquet

# krx_supplement regenerable bulk output (collect_*.py rebuilds these; the
# small index_* files and the 27 MB sector_mapping.parquet stay tracked).
# foreign_ownership_daily is 14.6k daily parquets (613 MB).
krx_supplement/output/foreign_ownership_daily/

# =============================================================================
# Run artifacts
# =============================================================================
*.log
nohup.*
*.bak
*.pid
__pycache__/
*.pyc
*.pyo

# Per-package run state (PID files, progress checkpoints, run logs — regenerable)
runtime/

# Stray PDFs
finmind_data/*.pdf

# Tracked: everything else (code, README/docs, small index CSVs/parquets,
# delisting_calendar.csv, missing_*.csv, krx_supplement/output/*, etc.)
